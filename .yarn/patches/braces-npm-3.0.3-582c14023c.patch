index 0000000000000000000000000000000000000000..083ca2282f7ce0cb52f4766fa2e5e1ba04c83487
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,10 @@
+'use strict';
+
+// Bound parser nesting and recursive AST walks (GHSA-vfj7-8cjw-p6xm).
+module.exports = depth => {
+  if (depth > 128) {
+    const error = new SyntaxError('Brace pattern exceeds maximum nesting depth (128)');
+    error.code = 'BRACES_MAX_DEPTH';
+    throw error;
+  }
+};
