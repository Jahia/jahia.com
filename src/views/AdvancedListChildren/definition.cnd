[jahiacom:advancedListChildren] > jnt:content, jahiacommix:gadget
 - parent (weakreference) < jnt:page, jnt:navMenuText, jnt:contentFolder
 - nodeType (string, choicelist[nodetypes=jmix:mainResource])
 - filterMode (string, choicelist[resourceBundle]) = 'hierarchy' mandatory autocreated < 'hierarchy', 'independent'
 - filter1Title (string) mandatory i18n
 - filter1Categories (weakreference, category[autoSelectParent=false]) multiple
 - emptyState (string, richtext) mandatory i18n
