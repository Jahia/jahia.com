[jahiacom:resourceCarousel] > jnt:content, mix:title, jahiacommix:cta, jahiacommix:container, jmix:editorialContent
 - subtitle (string) i18n
 - itemCount (long) = 9 mandatory < '[6,12]'
 - selectionMode (string, choicelist) = automatic mandatory < automatic, filtered, manual
 - completeFallback (boolean) = true mandatory
 - sourceRoot (weakreference, picker) < jnt:page, jnt:contentFolder
 - hidden (boolean) = false mandatory

[jahiacommix:resourceCarouselFilteredSelection] > jmix:dynamicFieldset mixin
 extends = jahiacom:resourceCarousel
 - filteredThemes (weakreference, category[autoSelectParent=false]) multiple
 - filteredContentTypes (weakreference, category[autoSelectParent=false]) multiple

[jahiacommix:resourceCarouselManualSelection] > jmix:dynamicFieldset mixin
 extends = jahiacom:resourceCarousel
 - selectedContent (weakreference, picker) multiple < jnt:page, jahiacom:blogEntry
 - manualThemes (weakreference, category[autoSelectParent=false]) multiple
 - manualContentTypes (weakreference, category[autoSelectParent=false]) multiple
