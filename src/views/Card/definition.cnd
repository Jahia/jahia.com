[jahiacom:card] > jnt:content, mix:title, jahiacommix:cta, jahiacommix:component, jmix:editorialContent
 - icon (weakreference, picker) i18n < jmix:image
 - image (weakreference, picker) i18n < jmix:image
 - cardTheme (string, choicelist[resourceBundle]) < 'day', 'cloudy', 'night'
 - background (string, choicelist[resourceBundle]) < 'plusses', 'stripes', 'matrix', 'bottom-grid', 'aura-top', 'aura-bottom'
 - body (string, richtext) i18n
 - cardPurpose (string, choicelist[resourceBundle]) = 'standard' < 'standard', 'partnerRegion', 'glossaryStatistic'
 - hideCtaIcon (boolean) = false

[jahiacommix:cardPartnerRegion] > jmix:dynamicFieldset mixin
 extends = jahiacom:card
 - regionTarget (string, choicelist[resourceBundle]) < 'europe', 'americas', 'apac'

[jahiacommix:cardGlossaryStatistic] > jmix:dynamicFieldset mixin
 extends = jahiacom:card
 - metric (string, choicelist[resourceBundle]) < 'entries', 'letters', 'updated'
 - entriesFolder (weakreference, picker) < jnt:contentFolder
