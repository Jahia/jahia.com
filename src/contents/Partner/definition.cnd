[jahiacom:partner] > jnt:content, jahiacommix:content, mix:title, jmix:visibleInContentTree, jmix:mainResource
 - partnerClassification (string, choicelist[resourceBundle]) < solution_silver, solution_gold, solution_diamond, technology_integration, technology_strategic
 - description (string, richtext) mandatory i18n
 - logo (weakreference, picker) < jmix:image
 // Dedicated Hero summary. shortDescription remains dedicated to the directory card.
 - heroSubtitle (string) i18n
 - shortDescription (string) i18n
 - website (string) i18n
 - partnerSince (date)
 // Shared location list used by partner profiles and the directory.
 - partnerLocationsData (string)
 - tags (weakreference, category[autoSelectParent=false]) multiple
 - aboutTitle (string) i18n
 - expertiseTitle (string) i18n
 // Unified rich content. Retired expertise sources require the local migration.
 - expertiseBody (string, richtext) i18n
 - partnership (string, richtext) i18n
 - partnershipImage (weakreference, picker) i18n < jmix:image
 - certifiedConsultants (long)
 - scope (string) i18n
 - testimonialsData (string) i18n
 + * (jahiacom:partnerProject)
 + * (jahiacom:partnerLocation)

// SEO fields for Partner resources. Kept separate from the page-only seoOptions mixin.
[jahiacommix:partnerSeo] mixin extends=jahiacom:partner itemtype=seo
 - htmlTitle (string) i18n
 - seoDescription (string, textarea) i18n
 - seoKeywords (string) i18n multiple
 - openGraphImage (weakreference, picker) < jmix:image
 - jsonLd (string, textarea) i18n multiple

[jahiacom:partnerLocation] > jnt:content, jmix:visibleInContentTree
 - region (string, choicelist[resourceBundle]) mandatory < europe, americas, apac
 - country (string)

[jahiacom:partnerProject] > jnt:content, mix:title, jmix:visibleInContentTree orderable
 - sector (string) i18n
 - projectType (string) i18n
 - description (string) i18n
 - image (weakreference, picker) i18n < jmix:image
