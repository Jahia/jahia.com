[jahiacom:blogEntry] > jnt:content, mix:title, jahiacommix:content, jmix:mainResource, jmix:visibleInContentTree, jmix:categorized
 - author (weakreference) mandatory < jahiacom:blogAuthor
 - summary (string) i18n
 - date (date) = now()
 - useLastModifiedDate (boolean) = false
 - blogType (weakreference) multiple facetable hierarchical
 - image (weakreference) < 'jmix:image'
 - text (string, richtext) i18n
 + resourceCarousel (jahiacom:blogResourceCarouselArea) = jahiacom:blogResourceCarouselArea autocreated
// The lines below are legacy props copied from https://github.com/Jahia/jahiacom/blob/master/jahiacom-templates/src/main/resources/META-INF/definitions.cnd
// - displayImageOnDetail (boolean) = 'true' indexed=no
// - hideBackButton (boolean) = 'false' indexed=no
// - hideRelated (boolean) = 'false' indexed=no
// + * (jmix:droppableContent) = jmix:droppableContent

// Dedicated editable area for the resource carousel displayed after a blog entry.
[jahiacom:blogResourceCarouselArea] > jnt:content,
  jmix:list,
  jmix:hiddenType
  orderable
 + carousel (jahiacom:resourceCarousel) = jahiacom:resourceCarousel autocreated
 + * (jahiacom:resourceCarousel)
