{
  "name": "jahia-card-carousel",
  "version": "1.0.7",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Standalone, editable Jahia card carousel extracted from the jahia.com Press Room",
  "type": "module",
  "files": [
    "dist",
    "src/**/*.cnd",
    "settings",
    "static"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && run package",
    "clean": "rm -rf dist/",
    "deploy": "jahia-deploy",
    "dev": "vite build --watch",
    "format": "prettier --write --list-different .",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "test": "node --test tests/*.test.mjs",
    "package": "yarn pack --out dist/package.tgz",
    "watch": "run dev",
    "watch:callback": "run package && run deploy"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.0.0",
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.26.0",
    "@jahia/javascript-modules-library": "1.2.0",
    "@jahia/vite-plugin": "1.2.0",
    "@types/react": "^19.1.2",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "i18next": "^25.6.3",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-i18next": "^16.3.5",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-order": "^7.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "xss": "1.0.15"
  },
  "packageManager": "yarn@4.10.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "jahia": {
    "name": "jahia-card-carousel",
    "required-version": "8.2.3.2",
    "module-dependencies": "default",
    "module-type": "module",
    "server": "dist/server/index.js",
    "static-resources": "/dist/client,/dist/assets,/locales,/images,/icons"
  }
}
